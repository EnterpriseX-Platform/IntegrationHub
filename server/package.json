{
  "name": "integration-platform-api",
  "version": "1.0.0",
  "description": "Backend API server for Integration Platform",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "ts-node scripts/db-reset.ts",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "integration",
    "api",
    "flows",
    "nodejs",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@duckdb/node-api": "^1.5.1-r.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^6.19.3",
    "@types/archiver": "^7.0.0",
    "@types/multer": "^2.0.0",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "archiver-zip-encryptable": "^1.0.10",
    "axios": "^1.13.4",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "extract-zip": "^2.0.1",
    "form-data": "^4.0.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "openpgp": "^6.3.0",
    "oracledb": "^6.10.0",
    "pg": "^8.18.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "ssh2": "^1.17.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.2.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/oracledb": "^6.10.1",
    "@types/pg": "^8.16.0",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^9.0.7",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
